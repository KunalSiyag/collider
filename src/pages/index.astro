---
import Base from '../layouts/Base.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import ElementCard from '../components/site/ElementCard.astro';
import InstallPill from '../components/site/InstallPill.astro';
import { elements, byCategory, type ElementCategory } from '../lib/registry';
import { categoryPath } from '../lib/categories';
import { createAlpineMeadow } from '../scenes/alpine-meadow';

/* The hero background is the Alpine Meadow scene, inlined at build time.
 * Because it is a static SVG (SMIL-animated), the hero renders with ZERO
 * JavaScript — no chunk downloads, no WebGL context, instant LCP.
 * To use an animated WebGL hero instead, restore:
 *   <div class="hero-bg" data-collider="particle-field" aria-hidden="true"></div>
 * To swap in another scene: import its generator from ../scenes/ and call it. */
const heroBackground = createAlpineMeadow();

const featured = [
  'particle-field',
  'wave-plane',
  'grid-floor',
  'distorted-sphere',
  'wireframe-globe',
  'liquid-knot',
].map((slug) => elements.find((e) => e.slug === slug)!);

const showcaseCategories: Array<[string, ElementCategory]> = [
  ['Scenes', 'Scenes'],
  ['Motion', 'Motion'],
  ['2.5D', '2.5D'],
  ['Elementals', 'Elementals'],
  ['Avatars', 'Avatars'],
  ['Textures', 'Textures'],
  ['Loaders', 'Loaders'],
  ['Buttons', 'Buttons'],
  ['Isometric', 'Isometric'],
  ['Effects', 'Effects'],
  ['Monsters', 'Monsters'],
  ['Shapes', 'Shapes'],
  ['Vector art', 'Vector'],
];
---

<Base>
  <Header />

  <section class="hero">
    <div class="hero-bg" aria-hidden="true" set:html={heroBackground} />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-content">
      <span class="badge">
        <span class="pulse-dot"></span>
        {elements.length} elements &middot; WebGL + SVG
      </span>
      <h1>
        Three.js elements,<br />
        <span class="text-gradient">ready to ship.</span>
      </h1>
      <p class="sub">
        Beautifully crafted, dependency-free 3D components for the modern web.
        Copy the source, paste it into your project, and own every line.
      </p>
      <div class="cta-row">
        <a href="/elements" class="btn btn-primary">Browse elements</a>
        <a href="#how" class="btn">How it works</a>
      </div>
      <div class="install-row">
        <InstallPill />
        <span class="hint">then copy any element below</span>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Featured</h2>
      <a href="/elements" class="see-all">
        View all {elements.length}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
    <div class="grid">
      {featured.map((meta) => <ElementCard meta={meta} />)}
    </div>
  </section>

  <section id="how" class="section container">
    <div class="section-head">
      <h2>How it works</h2>
    </div>
    <div class="steps">
      <div class="step">
        <span class="step-num">01</span>
        <h3>Install Three.js</h3>
        <p>One dependency. No wrapper libraries, no runtime lock-in.</p>
        <code>npm install three</code>
      </div>
      <div class="step">
        <span class="step-num">02</span>
        <h3>Copy the source</h3>
        <p>Every element is a single self-contained file. Read it, tweak it, keep it.</p>
        <code>elements/particle-field.ts</code>
      </div>
      <div class="step">
        <span class="step-num">03</span>
        <h3>Mount it anywhere</h3>
        <p>Each factory takes a container and options, returns a cleanup function.</p>
        <code>createParticleField(el)</code>
      </div>
    </div>
  </section>

  {
    showcaseCategories.map(([title, category]) => {
      const items = byCategory(category);
      if (items.length === 0) return null;
      return (
        <section class="section container">
          <div class="section-head">
            <h2>{title}</h2>
            <a href={categoryPath(category)} class="see-all">
              View all {items.length}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            </a>
          </div>
          <div class="grid">
            {items.slice(0, 4).map((meta) => (
              <ElementCard meta={meta} />
            ))}
          </div>
        </section>
      );
    })
  }

  <Footer />
</Base>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 60px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    /* Scrim for a BRIGHT scene with DARK text (see .hero overrides below):
     *   - top band stays dark so the fixed white header remains readable
     *   - the middle is nearly clear with a warm lift to help the dark
     *     headline pop against the sky, like the reference design
     *   - the bottom fades into the dark page background below the fold */
    background:
      radial-gradient(ellipse at 50% 40%, rgba(255, 250, 235, 0.4), transparent 62%),
      linear-gradient(
        to bottom,
        rgba(9, 9, 11, 0.55),
        rgba(9, 9, 11, 0.05) 30%,
        rgba(9, 9, 11, 0.02) 60%,
        rgba(9, 9, 11, 0.88) 97%
      );
    pointer-events: none;
  }

  /* ---- Light-content treatment -------------------------------------------
   * The hero artwork is a bright golden-hour scene, so the usual dark-theme
   * text (white/gray) would wash out. Inside .hero we flip to dark ink on
   * the pale sky — mirroring classic light landing pages. :global() is
   * required for parts rendered by child components (InstallPill). */
  .hero :global(.badge) {
    background: rgba(255, 255, 255, 0.92);
    border-color: transparent;
    color: #27272a;
    box-shadow: 0 2px 12px rgba(80, 50, 10, 0.22);
  }

  .hero h1 {
    color: #1c2431;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .hero h1 :global(.text-gradient) {
    background: linear-gradient(92deg, #6d28d9, #1d4ed8 70%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero .sub {
    color: #44403c;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .hero .btn:not(.btn-primary) {
    background: rgba(255, 255, 255, 0.92);
    color: #27272a;
    border-color: rgba(30, 20, 5, 0.12);
    box-shadow: 0 2px 12px rgba(80, 50, 10, 0.18);
  }

  .hero .btn:not(.btn-primary):hover {
    background: #ffffff;
    border-color: rgba(30, 20, 5, 0.2);
  }

  .hero .btn-primary {
    background: #18181b;
    color: #ffffff;
    border-color: #18181b;
  }

  .hero .btn-primary:hover {
    background: #2d2d33;
    border-color: #2d2d33;
  }

  .hero :global(.install-pill) {
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(30, 20, 5, 0.12);
    box-shadow: 0 2px 12px rgba(80, 50, 10, 0.18);
  }

  .hero :global(.install-pill code) {
    color: #b45309;
  }

  .hero :global(.install-pill .copy-btn) {
    color: #78716c;
  }

  .hero :global(.install-pill .copy-btn:hover) {
    color: #292524;
    background: rgba(30, 20, 5, 0.06);
  }

  .hero .hint {
    color: #57534e;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 96px;
  }

  h1 {
    font-size: clamp(40px, 7vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 700;
    margin-top: 20px;
  }

  .sub {
    max-width: 520px;
    color: var(--muted);
    font-size: 17px;
    margin-top: 22px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--accent-2);
    box-shadow: 0 0 8px var(--accent-2);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .cta-row {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .install-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  .hint {
    font-size: 12.5px;
    color: var(--muted-foreground);
  }

  .section {
    padding-block: 72px 8px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
  }

  h2 {
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .see-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13.5px;
    color: var(--muted);
    transition: color 150ms ease;
  }

  .see-all:hover {
    color: var(--foreground);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .step {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  .step h3 {
    font-size: 16px;
  }

  .step p {
    font-size: 13.5px;
    color: var(--muted);
    flex: 1;
  }

  .step code {
    font-size: 12px;
    color: #a5f3fc;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 8px 10px;
    overflow-x: auto;
    white-space: nowrap;
  }
</style>

<script>
  import '../lib/mount';
</script>
