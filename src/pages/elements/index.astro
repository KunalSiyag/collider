---
import Docs from '../../layouts/Docs.astro';
import ElementCard from '../../components/site/ElementCard.astro';
import { elements, categories, byCategory } from '../../lib/registry';
---

<Docs
  title={`Elements — Collider`}
  description={`${elements.length} ready-to-use Three.js and SVG elements. Copy, paste, ship.`}
>
  <h1>Elements</h1>
  <p class="lede">
    Every element is production-ready: typed options, resize handling, cleanup on
    destroy. WebGL elements need <code>three</code>; SVG art is dependency-free.
  </p>

  {
    categories.map((category) => {
      const items = byCategory(category);
      if (items.length === 0) return null;
      return (
        <section class="cat">
          <h2>{category}</h2>
          <div class="grid">
            {items.map((meta) => (
              <ElementCard meta={meta} />
            ))}
          </div>
        </section>
      );
    })
  }
</Docs>

<style>
  h1 {
    font-size: 34px;
    letter-spacing: -0.025em;
  }

  .lede {
    color: var(--muted);
    max-width: 560px;
    margin-top: 12px;
    font-size: 15.5px;
  }

  .lede code {
    font-size: 13px;
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 6px;
    border-radius: 5px;
  }

  .cat {
    margin-top: 48px;
  }

  h2 {
    font-size: 20px;
    letter-spacing: -0.015em;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }
</style>
