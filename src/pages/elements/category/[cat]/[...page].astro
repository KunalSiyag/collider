---
import Docs from '../../../../layouts/Docs.astro';
import ElementCard from '../../../../components/site/ElementCard.astro';
import { categories, byCategory, type ElementCategory } from '../../../../lib/registry';
import { categorySlug } from '../../../../lib/categories';

export function getStaticPaths({ paginate }: any) {
  return categories.flatMap((category) =>
    paginate(byCategory(category), {
      params: { cat: categorySlug(category) },
      props: { category },
      pageSize: 24,
    }),
  );
}

interface Props {
  category: ElementCategory;
  page: any;
}

const { category, page } = Astro.props;
const items = byCategory(category);
---

<Docs title={`${category} — Collider`} description={`Browse ${items.length} ${category} elements.`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/elements">Elements</a>
    <span>/</span>
    <a href={`/elements/category/${categorySlug(category)}`}>{category}</a>
    {
      page.currentPage > 1 && (
        <span>
          <span>/</span>
          <span class="current">Page {page.currentPage}</span>
        </span>
      )
    }
  </nav>

  <h1>{category}</h1>
  <p class="lede">
    {items.length} elements in this collection — showing {page.start + 1}–{page.end + 1}.
  </p>

  <div class="grid">
    {page.data.map((meta) => <ElementCard meta={meta} />)}
  </div>

  {
    page.lastPage > 1 && (
      <nav class="pager" aria-label="Pagination">
        {page.url.prev ? (
          <a class="pager-link" href={page.url.prev}>
            <span>Previous</span>
            <strong>
              Page {page.currentPage - 1} of {page.lastPage}
            </strong>
          </a>
        ) : (
          <span />
        )}
        {page.url.next ? (
          <a class="pager-link right" href={page.url.next}>
            <span>Next</span>
            <strong>
              Page {page.currentPage + 1} of {page.lastPage}
            </strong>
          </a>
        ) : (
          <span />
        )}
      </nav>
    )
  }
</Docs>

<style>
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--muted-foreground);
    margin-bottom: 18px;
  }

  .crumbs a:hover {
    color: var(--foreground);
  }

  .current {
    color: var(--foreground);
  }

  h1 {
    font-size: 34px;
    letter-spacing: -0.025em;
  }

  .lede {
    color: var(--muted);
    margin-top: 10px;
    margin-bottom: 28px;
    font-size: 15px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 3px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 14px 18px;
    min-width: 180px;
    transition:
      border-color 150ms ease,
      background 150ms ease;
  }

  .pager-link:hover {
    border-color: #3f3f46;
    background: var(--card);
  }

  .pager-link span {
    font-size: 11.5px;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pager-link strong {
    font-size: 14px;
    font-weight: 600;
  }

  .pager-link.right {
    text-align: right;
    align-items: flex-end;
  }
</style>
