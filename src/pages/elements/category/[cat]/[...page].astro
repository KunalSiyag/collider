---
/**
 * Category listing, paginated
 * ============================
 * Route:  /elements/category/[cat]          -> page 1
 *         /elements/category/[cat]/2 ... N  -> deeper pages
 *
 * HOW PAGINATION WORKS HERE (modify with care)
 * ---------------------------------------------
 * `getStaticPaths` runs once at build time. For every category we call Astro's
 * `paginate(items, {...})`, which slices the items into chunks of `pageSize`
 * and generates one static HTML page per chunk:
 *
 *   - The `[...page]` rest param in the filename receives "undefined" for the
 *     first page (rendering /elements/category/vector) and "2", "3", ... for
 *     later pages (/elements/category/vector/2).
 *   - Everything paginate() computes (currentPage, lastPage, url.prev/next,
 *     the sliced data array) is handed to this component via `Astro.props.page`.
 *   - `props: { category }` forwards extra data each generated page needs.
 *
 * To change how many cards appear per page, edit `pageSize` below.
 */
import Docs from '../../../../layouts/Docs.astro';
import ElementCard from '../../../../components/site/ElementCard.astro';
import Pagination from '../../../../components/site/Pagination.astro';
import { categories, byCategory, type ElementCategory, type ElementMeta } from '../../../../lib/registry';
import { categorySlug } from '../../../../lib/categories';

/** Generates one static page per chunk of PAGE_SIZE items, for every category.
 *  Runs entirely at build time — no runtime cost. */
export function getStaticPaths({ paginate }: { paginate: Function }) {
  return categories.flatMap((category) =>
    paginate(byCategory(category), {
      params: { cat: categorySlug(category) },
      props: { category },
      // Number of element cards shown per page. Change this to re-chunk the
      // listing (Astro regenerates every page on the next build).
      pageSize: 24,
    }),
  );
}

interface Props {
  category: ElementCategory;
  /* The shape Astro's paginate() hands us (a subset of its Page object). */
  page: {
    currentPage: number;
    lastPage: number;
    start: number;
    end: number;
    total: number;
    data: ElementMeta[];
    url: {
      first?: string;
      prev?: string;
      next?: string;
    };
  };
}

const { category, page } = Astro.props;

/* byCategory() is memoized in registry.ts, so calling it again here (in
 * addition to inside getStaticPaths) costs nothing at build time. We use the
 * full list only for the count shown in the lede text. */
const items = byCategory(category);
---

<Docs title={`${category} — Collider`} description={`Browse ${items.length} ${category} elements.`}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/elements">Elements</a>
    <span>/</span>
    <a href={`/elements/category/${categorySlug(category)}`}>{category}</a>
    {
      page.currentPage > 1 && (
        <span>
          <span>/</span>
          {/* Only the current page crumb renders as plain text — links to
              specific pages live in the pager below. */}
          <span class="current">Page {page.currentPage}</span>
        </span>
      )
    }
  </nav>

  <h1>{category}</h1>
  <p class="lede">
    {items.length} elements in this collection — showing {page.start + 1}–{page.end + 1}.
  </p>

  <div class="grid">
    {/* page.data is ONLY this page's slice of the full category list.
        ElementCard inlines the SVG preview for vector elements, so keeping
        pageSize moderate directly controls this page's HTML weight. */}
    {page.data.map((meta) => <ElementCard meta={meta} />)}
  </div>

  {/* Numbered pagination (1 … 4 [5] 6 … 20). Swap for simple prev/next links
      by replacing this with page.url.prev / page.url.next anchors. */}
  <Pagination page={page} ariaLabel={`${category} pagination`} />
</Docs>

<style>
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--muted-foreground);
    margin-bottom: 18px;
  }

  .crumbs a:hover {
    color: var(--foreground);
  }

  .current {
    color: var(--foreground);
  }

  h1 {
    font-size: 34px;
    letter-spacing: -0.025em;
  }

  .lede {
    color: var(--muted);
    margin-top: 10px;
    margin-bottom: 28px;
    font-size: 15px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
  }
</style>
