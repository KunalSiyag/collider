---
import { categories, byCategory, getElement, type ElementCategory } from '../../lib/registry';
import { categoryPath, categorySlug } from '../../lib/categories';

function slugFor(category: ElementCategory): string {
  return categorySlug(category);
}

const pathname = Astro.url.pathname.replace(/\/+$/, '');

let activeCategory: ElementCategory | undefined;
if (pathname.startsWith('/elements/category/')) {
  const catParam = pathname.split('/')[3];
  activeCategory = categories.find((c) => slugFor(c) === catParam);
} else if (pathname.startsWith('/elements/')) {
  const slug = pathname.split('/')[2];
  activeCategory = getElement(slug ?? '')?.category;
}
---

<aside class="sidebar">
  <div class="group">
    <a href="/elements" class:list={['group-link', { active: pathname === '/elements' }]}>
      Overview
    </a>
  </div>

  <div class="group">
    <h4>Categories</h4>
    <ul>
      {
        categories.map((category) => (
          <li>
            <a href={categoryPath(category)} class:list={{ active: activeCategory === category }}>
              {category}
              <span class="count">{byCategory(category).length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 60px;
    align-self: start;
    height: calc(100vh - 60px);
    overflow-y: auto;
    padding-block: 32px 64px;
    width: 220px;
    flex-shrink: 0;
  }

  .group {
    margin-bottom: 28px;
  }

  h4 {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--foreground);
    margin-bottom: 8px;
    padding-inline: 10px;
  }

  ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    font-size: 13.5px;
    color: var(--muted-foreground);
    padding: 5px 10px;
    border-radius: 6px;
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  a:hover {
    color: var(--foreground);
  }

  a.active,
  .group-link.active {
    color: var(--foreground);
    background: rgba(255, 255, 255, 0.05);
  }

  .count {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted-foreground);
    background: rgba(255, 255, 255, 0.06);
    border-radius: 999px;
    padding: 1px 7px;
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }
  }
</style>
