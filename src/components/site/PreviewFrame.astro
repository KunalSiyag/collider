---
interface Props {
  slug?: string;
  options?: Record<string, unknown>;
  html?: string;
  height?: number;
}

const { slug, options, html, height = 440 } = Astro.props;

const dataOptions = options ? JSON.stringify(options) : undefined;
---

<div class="preview-frame" style={`height: ${height}px`}>
  {slug && !html && <div class="mount" data-collider={slug} data-options={dataOptions}></div>}
  {html && <div class="mount vector" set:html={html} />}
</div>

<style>
  .preview-frame {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 0%, rgba(139, 92, 246, 0.05), transparent 60%),
      var(--background);
  }

  .mount {
    position: absolute;
    inset: 0;
  }

  .mount.vector {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .mount.vector :global(svg) {
    max-width: 100%;
    max-height: 100%;
    height: auto;
  }
</style>
