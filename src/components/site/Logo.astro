---
interface Props {
  size?: number;
}

const { size = 20 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="logo-grad" x1="0" y1="0" x2="24" y2="24">
      <stop offset="0%" stop-color="#8b5cf6"></stop>
      <stop offset="100%" stop-color="#22d3ee"></stop>
    </linearGradient>
  </defs>
  <circle cx="12" cy="12" r="9" stroke="url(#logo-grad)" stroke-width="2"></circle>
  <circle cx="12" cy="12" r="3" fill="url(#logo-grad)"></circle>
  <path d="M3.5 8.5L14.5 14.5M9.5 3.5L14.5 14.5M20.5 15.5L9.5 9.5M14.5 20.5L9.5 9.5" stroke="url(#logo-grad)" stroke-width="1.2" opacity="0.6"></path>
</svg>

<style>
  svg {
    display: block;
    flex-shrink: 0;
  }
</style>
