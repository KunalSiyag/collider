---
import { Code } from 'astro:components';
import CopyIcon from './CopyIcon.astro';

interface Props {
  code: string;
  lang?: 'ts' | 'bash' | 'html';
  filename?: string;
}

const { code, lang = 'ts', filename } = Astro.props;
---

<div class="codeblock">
  <div class="codeblock-header">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="filename">{filename ?? `element.${lang}`}</span>
    <button class="copy-btn" type="button" aria-label="Copy code">
      <CopyIcon size={13} />
      <span>Copy</span>
    </button>
  </div>
  <div class="codeblock-body">
    <Code code={code} lang={lang} theme="github-dark-default" />
  </div>
</div>

<style>
  .codeblock {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: #0d1117;
  }

  .codeblock-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.02);
  }

  .dots {
    display: flex;
    gap: 5px;
  }

  .dots i {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #27272a;
  }

  .filename {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--muted-foreground);
    margin-inline-end: auto;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 12px;
    padding: 4px 8px;
    border-radius: 6px;
    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .copy-btn:hover {
    color: var(--foreground);
    background: rgba(255, 255, 255, 0.06);
  }

  :global(.codeblock-body pre) {
    margin: 0;
    padding: 16px;
    font-size: 12.5px;
    line-height: 1.7;
    max-height: 480px;
    overflow: auto;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const block = btn.closest('.codeblock');
      const pre = block?.querySelector('pre');
      if (!pre) return;
      await navigator.clipboard.writeText(pre.textContent ?? '');
      const label = btn.querySelector('span');
      if (label) {
        label.textContent = 'Copied!';
        setTimeout(() => {
          label.textContent = 'Copy';
        }, 1400);
      }
    });
  });
</script>
